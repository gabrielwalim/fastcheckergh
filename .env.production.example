APP_ENV=production
APP_DEBUG=0
FASTCHECKERGH_ENV=production
FASTCHECKERGH_SITE_URL=https://your-domain.example
FCGH_ALLOW_DIAGNOSTICS=0
FCGH_ALLOW_SETUP=0
RETRIEVE_DEV_OTP=0
RETRIEVE_OTP_TTL=600

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=fastcheckergh
DB_USER=your_db_user
DB_PASSWORD=your_db_password

PAYSTACK_API_URL=https://api.paystack.co
PAYSTACK_SECRET_KEY=

BREVO_API_KEY=
BREVO_EMAIL_SENDER=
BREVO_EMAIL_SENDER_NAME=FastCheckerGH
BREVO_EMAIL_REPLY_TO=
BREVO_EMAIL_SANDBOX=0
BREVO_SMS_SENDER=FastCheckerGH
BREVO_WHATSAPP_SENDER=
BREVO_WHATSAPP_TEMPLATE_ID=
BREVO_WHATSAPP_ALLOW_TEXT=0

RESULT_PROVIDER=waec_api
WAEC_API_URL=
WAEC_API_TOKEN=
WAEC_API_AUTH_HEADER=Authorization
WAEC_API_AUTH_SCHEME=Bearer
WAEC_API_TIMEOUT=30
WAEC_API_VERIFY_SSL=1
