# FastCheckerGH local XAMPP configuration
# Copy this file to .env only if you want file-based local settings.
# Never share .env because it may contain private API keys.

APP_ENV=local
APP_DEBUG=1

DB_HOST=localhost
DB_PORT=3306
DB_NAME=fastcheckergh
DB_USER=root
DB_PASSWORD=

PAYSTACK_SECRET_KEY=
PAYSTACK_API_URL=https://api.paystack.co
FASTCHECKERGH_SITE_URL=http://localhost/fastcheckergh

FASTCHECKERGH_ENV=local
RETRIEVE_DEV_OTP=1
RETRIEVE_OTP_TTL=300

# Brevo - leave blank until you configure messaging.
BREVO_API_KEY=
BREVO_EMAIL_SENDER=
BREVO_EMAIL_SENDER_NAME=FastCheckerGH
BREVO_EMAIL_REPLY_TO=
BREVO_EMAIL_SANDBOX=1
BREVO_SMS_SENDER=FastCheckerGH
BREVO_WHATSAPP_SENDER=
BREVO_WHATSAPP_TEMPLATE_ID=
BREVO_WHATSAPP_ALLOW_TEXT=0

# Automatic results provider - requires authorized WAEC RVS/API access.
RESULT_PROVIDER=waec_api
WAEC_API_URL=
WAEC_API_TOKEN=
WAEC_API_AUTH_HEADER=Authorization
WAEC_API_AUTH_SCHEME=Bearer
WAEC_API_TIMEOUT=30
WAEC_API_VERIFY_SSL=1

# Local-only admin setup/diagnostic tools.
FCGH_ALLOW_DIAGNOSTICS=1
FCGH_ALLOW_SETUP=1
